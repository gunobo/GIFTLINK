# DB
DATABASE_URL=mysql+pymysql://giftlink:giftlink@localhost:3306/giftlink

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 관리자 계정 (초기 시드용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 발송 채널 (Solapi — https://console.solapi.com)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
# 카카오 알림톡: Solapi 콘솔에서 카카오 채널 연동 후 발급되는 pfId
# (알림톡 템플릿 ID는 채널별이 아니라 메시지 템플릿마다 다르므로 관리자 페이지에서 템플릿 작성 시 입력)
SOLAPI_KAKAO_PF_ID=

# 이메일
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 프론트엔드에서 교환 링크 생성 시 사용할 base url
# 로컬 개발: http://localhost:5173 (frontend/vite.config.ts)
# Docker Compose(라즈베리파이): 실제 배포 도메인(예: https://giftlink.imjemin.co.kr)으로 교체
PUBLIC_BASE_URL=http://localhost:5173
